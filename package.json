{
  "name": "decoy",
  "version": "0.4.0",
  "private": true,
  "description": "Decoy — the master browser-session recorder. Faithfully captures every request/response, cookie, storage, WebSocket frame and screenshot across pages, popups, iframes and workers, so downstream modules can replay/extract without reimplementing capture.",
  "author": "Yann Allard",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:type": "tsc --noEmit",
    "check:lint": "oxlint -c .oxlintrc.json",
    "fix:lint": "oxlint -c .oxlintrc.json --fix",
    "check:format": "oxfmt --check .",
    "fix:format": "oxfmt --write .",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:type",
    "fix": "pnpm fix:lint && pnpm fix:format",
    "lint": "pnpm check:lint",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "0.47.0",
    "@oxlint/binding-win32-x64-msvc": "1.67.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^38.4.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^5.0.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
