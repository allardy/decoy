{
  "name": "decoy",
  "version": "0.1.1",
  "private": true,
  "description": "Decoy — the master browser-session recorder. Faithfully captures every request/response, cookie, storage, WebSocket frame and screenshot across pages, popups, iframes and workers, so downstream modules can replay/extract without reimplementing capture.",
  "license": "MIT",
  "author": "Yann Allard",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:type": "tsc --noEmit",
    "check:lint": "oxlint -c .oxlintrc.json",
    "fix:lint": "oxlint -c .oxlintrc.json --fix",
    "check:format": "oxfmt --check .",
    "fix:format": "oxfmt --write .",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:type",
    "fix": "pnpm fix:lint && pnpm fix:format",
    "lint": "pnpm check:lint",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@oxfmt/binding-win32-x64-msvc": "0.52.0",
    "@oxlint/binding-win32-x64-msvc": "1.67.0",
    "@rolldown/binding-win32-x64-msvc": "1.0.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "~6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
